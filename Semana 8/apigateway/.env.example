# Direccion y configuracion publica de Vault
VAULT_ADDR=http://127.0.0.1:8200
VAULT_MOUNT_POINT=secret
VAULT_SECRET_PATH=tokyo-noodles/security

# Completar solamente en el archivo .env local. Nunca subir los valores reales.
VAULT_TOKEN=
TOKYO_CLIENT_TOKEN=
TOKYO_GATEWAY_SECRET=

# Direccion interna del backend
BACKEND_URL=http://127.0.0.1:9000
BACKEND_TIMEOUT=5.0
